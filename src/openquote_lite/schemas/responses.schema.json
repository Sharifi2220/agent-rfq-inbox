{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openquote-lite:schema:0.1:responses",
  "title": "OpenQuote Lite responses 0.1",
  "description": "Receipt, status and error documents returned by an OpenQuote Lite endpoint. Receipts and status documents are never quotes and never commitments; both carry is_quote=false and is_commitment=false as machine-readable guards.",
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openquote", "request_id", "status", "received_at", "provider", "message",
        "notice", "next_step", "is_quote", "is_commitment", "status_url", "replayed"
      ],
      "properties": {
        "openquote": {"const": "0.1"},
        "request_id": {"type": "string", "pattern": "^oqr_[A-Za-z0-9_-]{24}$"},
        "status": {"const": "received"},
        "received_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
        },
        "message": {"type": "string"},
        "notice": {"type": "string"},
        "next_step": {"const": "human_review"},
        "response_time_hint": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "is_quote": {"const": false},
        "is_commitment": {"const": false},
        "status_url": {"type": "string"},
        "replayed": {"type": "boolean"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openquote", "request_id", "status", "updated_at", "message", "is_quote", "is_commitment"],
      "properties": {
        "openquote": {"const": "0.1"},
        "request_id": {"type": "string", "pattern": "^oqr_[A-Za-z0-9_-]{24}$"},
        "status": {"enum": ["received", "in_review", "follow_up_planned", "declined", "closed"]},
        "decline_reason": {"enum": ["outside_service_area", "service_not_offered", "no_capacity", "duplicate", "other"]},
        "updated_at": {"type": "string"},
        "message": {"type": "string"},
        "is_quote": {"const": false},
        "is_commitment": {"const": false}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openquote", "error"],
      "properties": {
        "openquote": {"const": "0.1"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "pattern": "^[a-z_]+$"},
            "message": {"type": "string"},
            "retry_after_seconds": {"type": "integer", "minimum": 1},
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "code", "message"],
                "properties": {
                  "path": {"type": "string"},
                  "code": {"type": "string"},
                  "message": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
